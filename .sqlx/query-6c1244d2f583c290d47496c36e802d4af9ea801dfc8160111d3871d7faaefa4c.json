  "query": "SELECT e.title, e.location, e.starts_at, e.ends_at, e.all_day AS \"all_day!: bool\"\n           FROM calendar_events e\n           JOIN calendar_sources s ON s.id = e.source_id\n           WHERE s.user_id = ? AND s.space_id = ? AND e.ends_at > ? AND e.starts_at < ?\n           ORDER BY e.starts_at, e.ends_at",
