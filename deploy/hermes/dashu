#!/usr/bin/env python3
"""dashu : piloter le dashboard de Rémi depuis le terminal (utilisé par Hermès).

Lit l'adresse et le jeton de l'API dans ~/.config/dashu/url et ~/.config/dashu/token :
le jeton n'apparaît donc jamais dans une commande ni dans une conversation.

Exemples :
  dashu tasks --space ecole
  dashu task-add "Réviser le VLAN" --space ecole --due 2026-11-20
  dashu task-done 12
  dashu notes --q vlan
  dashu note 5
  dashu note-add "Idée" --space perso --body "texte" --tag projet
  dashu note-append 5 "Une ligne de plus"
  dashu agenda --from 2026-11-16 --to 2026-11-20
  dashu files --space ecole --q devis
  dashu file-put ~/devis.pdf --space taff
  dashu folders --space ecole
  dashu trash
  dashu admin status

Ajoute --json à n'importe quelle commande de lecture pour la réponse brute.
"""

import argparse
import json
import os
import subprocess
import sys
import urllib.error
import urllib.parse
import urllib.request
from datetime import datetime

CONFIG = os.path.expanduser("~/.config/dashu")
DAYS = ["lun.", "mar.", "mer.", "jeu.", "ven.", "sam.", "dim."]
SPACES = "slug d'un espace (dashu spaces les liste : perso, ecole, taff…)"
ADMIN_COMMANDS = ["status", "logs", "restart", "update", "update-status", "backup"]


def fail(message, code=1):
    print(f"erreur : {message}", file=sys.stderr)
    sys.exit(code)


def read_config(name):
    path = os.path.join(CONFIG, name)
    try:
        with open(path, encoding="utf-8") as f:
            return f.read().strip()
    except OSError:
        fail(f"{path} introuvable : dashu n'est pas configuré sur cette machine")


def call(method, path, params=None, body=None):
    """Appelle l'API et renvoie le JSON décodé (None pour une réponse vide)."""
    url = read_config("url").rstrip("/") + "/api/v1" + path
    if params:
        clean = {k: v for k, v in params.items() if v not in (None, "")}
        if clean:
            url += "?" + urllib.parse.urlencode(clean)
    data = None
    headers = {"Authorization": "Bearer " + read_config("token"), "Accept": "application/json"}
    if body is not None:
        data = json.dumps(body).encode("utf-8")
        headers["Content-Type"] = "application/json"
    request = urllib.request.Request(url, data=data, method=method, headers=headers)
    try:
        with urllib.request.urlopen(request, timeout=30) as response:
            raw = response.read()
    except urllib.error.HTTPError as e:
        try:
            message = json.loads(e.read()).get("error", "")
        except (ValueError, AttributeError):
            message = ""
        fail(f"{e.code} {message}".strip())
    except urllib.error.URLError as e:
        fail(f"dashu injoignable ({e.reason}) : le conteneur est-il allumé ?")
    return json.loads(raw) if raw else None


def call_raw(method, path, params=None, data=None):
    """Appelle l'API sans JSON : un contenu à envoyer ou à recevoir (fichiers)."""
    url = read_config("url").rstrip("/") + "/api/v1" + path
    if params:
        url += "?" + urllib.parse.urlencode(params)
    headers = {"Authorization": "Bearer " + read_config("token")}
    if data is not None:
        headers["Content-Type"] = "application/octet-stream"
    request = urllib.request.Request(url, data=data, method=method, headers=headers)
    try:
        with urllib.request.urlopen(request, timeout=300) as response:
            return response.status, response.read()
    except urllib.error.HTTPError as e:
        body = e.read()
        if e.code == 409:
            return e.code, body
        try:
            message = json.loads(body).get("error", "")
        except (ValueError, AttributeError):
            message = ""
        fail(f"{e.code} {message}".strip())
    except urllib.error.URLError as e:
        fail(f"dashu injoignable ({e.reason}) : le conteneur est-il allumé ?")


def upload(path, place):
    """Envoie un fichier en morceaux de 50 Mo, comme le site."""
    size = os.path.getsize(path)
    start = call("POST", "/files/uploads", body={"name": os.path.basename(path), "size": size, **place})
    chunk = min(start["chunk_max"], 50 * 1024 * 1024)
    offset = 0
    with open(path, "rb") as f:
        while True:
            f.seek(offset)
            data = f.read(chunk)
            status, raw = call_raw("PUT", f"/files/uploads/{start['upload']}", {"offset": offset}, data)
            reply = json.loads(raw)
            if status == 201:
                return reply
            offset = reply["received"]


def size_label(n):
    for unit in ["o", "Ko", "Mo", "Go"]:
        if n < 1024 or unit == "Go":
            return f"{n:.0f} {unit}" if unit == "o" else f"{n:.1f} {unit}"
        n /= 1024


def fmt_files(files):
    if not files:
        print("Aucun fichier.")
    for f in files:
        where = "Temporaire" if f["temporary"] else f["space"] + (f" / dossier {f['folder']}" if f["folder"] else "")
        tags = " " + " ".join("#" + t for t in f["tags"]) if f["tags"] else ""
        print(f"#{f['id']} {f['name']} ({size_label(f['size'])}, {where}){tags}")


def fmt_job(j):
    result = f" -> #{j['result']['id']} {j['result']['name']}" if j.get("result") else ""
    error = f" ({j['error']})" if j.get("error") else ""
    progress = f" {j['progress']} %" if j["status"] == "running" else ""
    print(f"conversion #{j['id']} {j['label']} de {j['source_name']} : {j['status']}{progress}{error}{result}")


def fmt_folders(folders):
    if not folders:
        print("Aucun dossier.")
    by_parent = {}
    for f in folders:
        by_parent.setdefault(f["parent"], []).append(f)
    for top in by_parent.get(None, []):
        print(f"#{top['id']} {top['name']} [{top['space']}]")
        for sub in by_parent.get(top["id"], []):
            print(f"    #{sub['id']} {sub['name']}")


def fmt_trash(items):
    if not items:
        print("La corbeille est vide.")
    for i in items:
        contents = f" ({i['contents']})" if i.get("contents") else ""
        print(f"{i['kind']} #{i['id']} {i['name']}{contents} · {i['origin']} · par {i['deleted_by']}, depuis {i['via']}, le {day_label(i['deleted_at'])}")


def day_label(iso_date):
    """« 2026-11-16 » -> « lun. 16/11 »"""
    d = datetime.strptime(iso_date[:10], "%Y-%m-%d")
    return f"{DAYS[d.weekday()]} {d.day:02d}/{d.month:02d}"


def show(data, args, formatter):
    if getattr(args, "json", False):
        print(json.dumps(data, ensure_ascii=False, indent=2))
    else:
        formatter(data)


def fmt_task(t):
    box = "[x]" if t["done"] else "[ ]"
    due = f", pour {day_label(t['due_date'])}" if t.get("due_date") else ""
    return f"#{t['id']} {box} {t['title']} ({t['space']}{due})"


def fmt_tasks(tasks):
    if not tasks:
        print("Aucune tâche.")
    for t in tasks:
        print(fmt_task(t))


def fmt_notes(notes):
    if not notes:
        print("Aucune note.")
    for n in notes:
        title = n["title"] or "Sans titre"
        pin = " (épinglée)" if n["pinned"] else ""
        tags = " " + " ".join("#" + t for t in n["tags"]) if n["tags"] else ""
        excerpt = n["excerpt"].replace("\n", " ").strip()
        line = f"#{n['id']} {title} [{n['space']}]{pin}{tags}"
        print(line + (f" : {excerpt[:140]}" if excerpt else ""))


def fmt_note(n):
    tags = " ".join("#" + t for t in n["tags"]) or "aucun"
    print(f"#{n['id']} {n['title'] or 'Sans titre'}")
    print(f"Espace : {n['space']} · tags : {tags} · modifiée le {day_label(n['updated_at'])} à {n['updated_at'][11:16]}")
    print()
    print(n["body_md"] or "(vide)")


def fmt_events(events):
    if not events:
        print("Rien à l'agenda sur cette période.")
    current_day = None
    for e in events:
        day = day_label(e["start"])
        if day != current_day:
            print(day)
            current_day = day
        when = "journée" if e["all_day"] else f"{e['start'][11:16]}-{e['end'][11:16]}"
        details = f" · {e['details']}" if e["details"] else ""
        place = f" ({e['location']})" if e["location"] else ""
        print(f"  {when} {e['subject']}{details}{place}")


def admin(args):
    command = [args.action]
    if args.action == "logs":
        command.append(str(args.lines))
    try:
        result = subprocess.run(
            ["ssh", "dashu-admin", *command],
            capture_output=True,
            text=True,
            timeout=120,
        )
    except subprocess.TimeoutExpired:
        fail("la commande d'admin n'a pas répondu en 2 minutes")
    sys.stdout.write(result.stdout)
    sys.stderr.write(result.stderr)
    sys.exit(result.returncode)


def main():
    p = argparse.ArgumentParser(prog="dashu", description="Piloter dashu (tâches, notes, fichiers, dossiers, agenda, admin).")
    sub = p.add_subparsers(dest="cmd", required=True)

    def reader(name, help_text):
        s = sub.add_parser(name, help=help_text)
        s.add_argument("--json", action="store_true", help="réponse brute en JSON")
        return s

    reader("spaces", "liste des espaces")

    s = reader("tasks", "liste des tâches")
    s.add_argument("--space", help=SPACES)
    s.add_argument("--status", choices=["open", "done", "all"], default="open")

    s = sub.add_parser("task-add", help="ajoute une tâche")
    s.add_argument("title")
    s.add_argument("--space", required=True, help=SPACES)
    s.add_argument("--due", help="AAAA-MM-JJ (par défaut : aujourd'hui)")

    for name, help_text in [("task-done", "coche une tâche"), ("task-undone", "décoche une tâche"), ("task-rm", "supprime une tâche")]:
        s = sub.add_parser(name, help=help_text)
        s.add_argument("id", type=int)

    s = sub.add_parser("task-edit", help="modifie une tâche")
    s.add_argument("id", type=int)
    s.add_argument("--title")
    s.add_argument("--due", help="AAAA-MM-JJ")

    s = reader("notes", "liste ou recherche des notes")
    s.add_argument("--q", help="recherche plein texte")
    s.add_argument("--space", help=SPACES)
    s.add_argument("--tag")
    s.add_argument("--limit", type=int, default=10)

    s = reader("note", "affiche une note complète")
    s.add_argument("id", type=int)

    s = sub.add_parser("note-add", help="crée une note")
    s.add_argument("title")
    s.add_argument("--space", required=True, help=SPACES)
    s.add_argument("--body", default="", help="texte Markdown")
    s.add_argument("--body-file", help="lit le texte dans un fichier")
    s.add_argument("--tag", action="append", default=[], help="répétable")

    s = sub.add_parser("note-append", help="ajoute du texte à la fin d'une note")
    s.add_argument("id", type=int)
    s.add_argument("text")

    s = sub.add_parser("note-edit", help="modifie une note")
    s.add_argument("id", type=int)
    s.add_argument("--title")
    s.add_argument("--body", help="remplace tout le texte")
    s.add_argument("--pin", action="store_true")
    s.add_argument("--unpin", action="store_true")
    s.add_argument("--move", help="nouvel espace : " + SPACES)
    s.add_argument("--tag", action="append", default=[], help="ajoute un tag (répétable)")
    s.add_argument("--untag", action="append", default=[], help="retire un tag (répétable)")
    s.add_argument("--folder", type=int, help="range dans ce dossier de son espace")
    s.add_argument("--root", action="store_true", help="range à la racine de son espace")

    s = sub.add_parser("note-rm", help="met une note dans la corbeille")
    s.add_argument("id", type=int)

    s = sub.add_parser("note-md", help="télécharge une note en Markdown")
    s.add_argument("id", type=int)
    s.add_argument("--out", help="fichier où l'écrire (sinon : à l'écran)")

    s = reader("files", "liste ou recherche des fichiers")
    s.add_argument("--space", help=SPACES)
    s.add_argument("--folder", type=int)
    s.add_argument("--tag")
    s.add_argument("--q", help="mots du nom")
    s.add_argument("--temporary", action="store_true", help="les fichiers de Temporaire")
    s.add_argument("--limit", type=int, default=20)

    s = reader("file", "informations d'un fichier")
    s.add_argument("id", type=int)

    s = sub.add_parser("file-get", help="télécharge un fichier")
    s.add_argument("id", type=int)
    s.add_argument("--out", required=True, help="chemin où l'écrire")

    s = sub.add_parser("file-put", help="envoie un fichier")
    s.add_argument("path")
    s.add_argument("--space", help=SPACES)
    s.add_argument("--folder", type=int)
    s.add_argument("--temporary", action="store_true")

    s = sub.add_parser("file-edit", help="renomme, range, tague un fichier")
    s.add_argument("id", type=int)
    s.add_argument("--name", help="nouveau nom (l'extension ne change pas)")
    s.add_argument("--move", help="espace où le ranger : " + SPACES)
    s.add_argument("--folder", type=int, help="dossier où le ranger")
    s.add_argument("--root", action="store_true", help="à la racine de l'espace")
    s.add_argument("--keep", help="garde un fichier de Temporaire dans cet espace")
    s.add_argument("--tag", action="append", default=[])
    s.add_argument("--untag", action="append", default=[])

    s = sub.add_parser("file-rm", help="met un fichier dans la corbeille")
    s.add_argument("id", type=int)

    s = reader("shares", "liens de partage d'un fichier")
    s.add_argument("id", type=int)

    s = sub.add_parser("share", help="crée un lien de partage public")
    s.add_argument("id", type=int)
    s.add_argument("--for", dest="duration", choices=["1h", "1j", "7j"], required=True)

    s = sub.add_parser("share-rm", help="révoque un lien de partage")
    s.add_argument("id", type=int)
    s.add_argument("link", type=int)

    s = reader("folders", "dossiers")
    s.add_argument("--space", help=SPACES)

    s = sub.add_parser("folder-add", help="crée un dossier")
    s.add_argument("name")
    s.add_argument("--space", help=SPACES)
    s.add_argument("--parent", type=int, help="dossier du premier niveau")

    s = sub.add_parser("folder-edit", help="renomme ou déplace un dossier (avec son contenu)")
    s.add_argument("id", type=int)
    s.add_argument("--name")
    s.add_argument("--move", help="espace où l'emmener : " + SPACES)
    s.add_argument("--parent", type=int, help="dossier du premier niveau où le mettre")
    s.add_argument("--root", action="store_true", help="à la racine de l'espace")

    s = sub.add_parser("folder-rm", help="met un dossier et son contenu dans la corbeille")
    s.add_argument("id", type=int)

    s = reader("formats", "conversions possibles d'un fichier")
    s.add_argument("id", type=int)

    s = sub.add_parser("convert", help="convertit (ou compresse) un fichier")
    s.add_argument("id", type=int)
    s.add_argument("--to", required=True, help="une valeur de dashu formats ID (compress pour compresser)")
    s.add_argument("--pages", help="pour --to pages : 2-4")

    s = reader("jobs", "conversions récentes")
    s.add_argument("--active", action="store_true", help="seulement celles en cours")

    s = reader("job", "où en est une conversion")
    s.add_argument("id", type=int)

    s = sub.add_parser("replace", help="le résultat d'une conversion remplace l'original (mis dans la corbeille)")
    s.add_argument("id", type=int, help="numéro de la conversion")

    reader("trash", "ce qui est dans la corbeille")

    s = sub.add_parser("restore", help="restaure depuis la corbeille")
    s.add_argument("kind", choices=["note", "fichier", "dossier", "espace"])
    s.add_argument("id", type=int)

    s = reader("agenda", "événements de l'agenda (7 jours par défaut)")
    s.add_argument("--from", dest="start", help="AAAA-MM-JJ (par défaut : aujourd'hui)")
    s.add_argument("--to", dest="end", help="AAAA-MM-JJ, inclus")
    s.add_argument("--space", help=SPACES)

    sub.add_parser("agenda-refresh", help="resynchronise les flux iCal")

    s = sub.add_parser("admin", help="administration du serveur dashu")
    s.add_argument("action", choices=ADMIN_COMMANDS)
    s.add_argument("lines", nargs="?", type=int, default=50, help="pour logs : nombre de lignes")

    args = p.parse_args()

    if args.cmd == "spaces":
        show(call("GET", "/spaces"), args, lambda d: print("\n".join(f"{s['slug']} ({s['name']})" for s in d)))
    elif args.cmd == "tasks":
        show(call("GET", "/tasks", {"space": args.space, "status": args.status}), args, fmt_tasks)
    elif args.cmd == "task-add":
        body = {"title": args.title, "space": args.space}
        if args.due:
            body["due_date"] = args.due
        print("Ajoutée : " + fmt_task(call("POST", "/tasks", body=body)))
    elif args.cmd in ("task-done", "task-undone"):
        t = call("PATCH", f"/tasks/{args.id}", body={"done": args.cmd == "task-done"})
        print(fmt_task(t))
    elif args.cmd == "task-edit":
        body = {}
        if args.title:
            body["title"] = args.title
        if args.due:
            body["due_date"] = args.due
        if not body:
            fail("rien à modifier : --title et/ou --due")
        print(fmt_task(call("PATCH", f"/tasks/{args.id}", body=body)))
    elif args.cmd == "task-rm":
        call("DELETE", f"/tasks/{args.id}")
        print(f"Tâche #{args.id} supprimée.")
    elif args.cmd == "notes":
        params = {"q": args.q, "space": args.space, "tag": args.tag, "limit": args.limit}
        show(call("GET", "/notes", params), args, fmt_notes)
    elif args.cmd == "note":
        show(call("GET", f"/notes/{args.id}"), args, fmt_note)
    elif args.cmd == "note-add":
        text = args.body
        if args.body_file:
            with open(args.body_file, encoding="utf-8") as f:
                text = f.read()
        n = call("POST", "/notes", body={"title": args.title, "body_md": text, "space": args.space, "tags": args.tag})
        print(f"Note #{n['id']} créée dans {n['space']}.")
    elif args.cmd == "note-append":
        n = call("PATCH", f"/notes/{args.id}", body={"append": args.text})
        print(f"Ajouté à la note #{n['id']} ({n['title'] or 'Sans titre'}).")
    elif args.cmd == "note-edit":
        body = {}
        if args.title is not None:
            body["title"] = args.title
        if args.body is not None:
            body["body_md"] = args.body
        if args.pin or args.unpin:
            body["pinned"] = bool(args.pin)
        if args.move:
            body["space"] = args.move
        if args.tag:
            body["add_tags"] = args.tag
        if args.untag:
            body["remove_tags"] = args.untag
        if args.folder is not None:
            body["folder"] = args.folder
        elif args.root:
            body["folder"] = None
        if not body:
            fail("rien à modifier")
        n = call("PATCH", f"/notes/{args.id}", body=body)
        print(f"Note #{n['id']} modifiée ({n['space']}).")
    elif args.cmd == "note-rm":
        call("DELETE", f"/notes/{args.id}")
        print(f"Note #{args.id} mise dans la corbeille (30 jours pour la restaurer).")
    elif args.cmd == "note-md":
        _, raw = call_raw("GET", f"/notes/{args.id}/download.md")
        if args.out:
            with open(args.out, "wb") as f:
                f.write(raw)
            print(f"Écrit dans {args.out}.")
        else:
            sys.stdout.write(raw.decode("utf-8"))
    elif args.cmd == "files":
        params = {"space": args.space, "folder": args.folder, "tag": args.tag, "q": args.q,
                  "temporary": "true" if args.temporary else None, "limit": args.limit}
        show(call("GET", "/files", params), args, fmt_files)
    elif args.cmd == "file":
        show(call("GET", f"/files/{args.id}"), args, lambda f: fmt_files([f]))
    elif args.cmd == "file-get":
        _, raw = call_raw("GET", f"/files/{args.id}/download")
        with open(args.out, "wb") as f:
            f.write(raw)
        print(f"{len(raw)} octets écrits dans {args.out}.")
    elif args.cmd == "file-put":
        place = {"temporary": True} if args.temporary else {}
        if args.space:
            place["space"] = args.space
        if args.folder:
            place["folder"] = args.folder
        f = upload(os.path.expanduser(args.path), place)
        print("Envoyé : ", end="")
        fmt_files([f])
    elif args.cmd == "file-edit":
        body = {}
        if args.name:
            body["name"] = args.name
        if args.keep:
            body["keep"] = True
            body["space"] = args.keep
        elif args.move:
            body["space"] = args.move
        if args.folder is not None:
            body["folder"] = args.folder
        elif args.root:
            body["folder"] = None
        if args.tag:
            body["add_tags"] = args.tag
        if args.untag:
            body["remove_tags"] = args.untag
        if not body:
            fail("rien à modifier")
        fmt_files([call("PATCH", f"/files/{args.id}", body=body)])
    elif args.cmd == "file-rm":
        call("DELETE", f"/files/{args.id}")
        print(f"Fichier #{args.id} mis dans la corbeille (30 jours pour le restaurer).")
    elif args.cmd == "shares":
        show(call("GET", f"/files/{args.id}/shares"), args,
             lambda links: print("\n".join(f"lien #{l['id']}, jusqu'au {day_label(l['expires_at'])} à {l['expires_at'][11:16]}" for l in links) or "Aucun lien."))
    elif args.cmd == "share":
        link = call("POST", f"/files/{args.id}/shares", body={"duration": args.duration})
        print(f"Lien #{link['id']} : {link['url']} (jusqu'au {day_label(link['expires_at'])} à {link['expires_at'][11:16]})")
    elif args.cmd == "share-rm":
        call("DELETE", f"/files/{args.id}/shares/{args.link}")
        print(f"Lien #{args.link} révoqué.")
    elif args.cmd == "folders":
        show(call("GET", "/folders", {"space": args.space}), args, fmt_folders)
    elif args.cmd == "folder-add":
        body = {"name": args.name}
        if args.parent:
            body["parent"] = args.parent
        elif args.space:
            body["space"] = args.space
        else:
            fail("--space ou --parent")
        d = call("POST", "/folders", body=body)
        print(f"Dossier #{d['id']} « {d['name']} » créé dans {d['space']}.")
    elif args.cmd == "folder-edit":
        body = {}
        if args.name:
            body["name"] = args.name
        if args.move:
            body["space"] = args.move
        if args.parent is not None:
            body["parent"] = args.parent
        elif args.root:
            body["parent"] = None
        if not body:
            fail("rien à modifier")
        d = call("PATCH", f"/folders/{args.id}", body=body)
        print(f"Dossier #{d['id']} « {d['name']} » ({d['space']}).")
    elif args.cmd == "folder-rm":
        call("DELETE", f"/folders/{args.id}")
        print(f"Dossier #{args.id} mis dans la corbeille avec son contenu (30 jours pour le restaurer).")
    elif args.cmd == "formats":
        show(call("GET", f"/files/{args.id}/conversions"), args,
             lambda fs: print("\n".join(f"{f['to']} : {f['label']}" for f in fs) or "Aucune conversion possible."))
    elif args.cmd == "convert":
        body = {"to": args.to}
        if args.pages:
            body["pages"] = args.pages
        fmt_job(call("POST", f"/files/{args.id}/convert", body=body))
    elif args.cmd == "jobs":
        show(call("GET", "/jobs", {"active": "true" if args.active else None}), args,
             lambda js: [fmt_job(j) for j in js] or print("Aucune conversion."))
    elif args.cmd == "job":
        show(call("GET", f"/jobs/{args.id}"), args, fmt_job)
    elif args.cmd == "replace":
        r = call("POST", f"/jobs/{args.id}/replace")
        print(f"Il reste #{r['file']['id']} {r['file']['name']} ; l'original est dans la corbeille.")
    elif args.cmd == "trash":
        show(call("GET", "/trash"), args, fmt_trash)
    elif args.cmd == "restore":
        r = call("POST", f"/trash/{args.kind}/{args.id}/restore")
        print(f"« {r['restored']} » est revenu à sa place.")
    elif args.cmd == "agenda":
        params = {"from": args.start, "to": args.end, "space": args.space}
        show(call("GET", "/calendar", params), args, fmt_events)
    elif args.cmd == "agenda-refresh":
        r = call("POST", "/calendar/refresh")
        print(f"{r['sources']} agenda(s) resynchronisé(s), {r['failures']} échec(s).")
    elif args.cmd == "admin":
        admin(args)


if __name__ == "__main__":
    main()
