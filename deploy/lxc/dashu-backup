#!/usr/bin/env bash
# Sauvegarde de la base et des fichiers, lancée chaque nuit à 3 h 30 par
# dashu-backup.timer.
#
# `dashu backup` fait une copie à chaud (VACUUM INTO) sans arrêter le service,
# puis la rouvre pour la vérifier (PRAGMA integrity_check). Les copies de plus
# de 14 jours sont supprimées ; celles faites avant une mise à jour ou une
# restauration sont gardées 30 jours.
#
# Puis dashu-backup-files fait l'instantané des fichiers envoyés, sur l'autre
# disque, avec le même horodatage : dashu-restore remet ensemble une base et
# ses fichiers.
set -euo pipefail

DIR=/var/backups/dashu
STAMP="$(date +%F_%H%M%S)"
DEST="$DIR/dashu-$STAMP.db"

runuser -u dashu -- env DATABASE_URL=sqlite:///var/lib/dashu/dashu.db /usr/local/bin/dashu backup "$DEST"
# Secret de session créé par dashu quand SESSION_SECRET n'est pas dans
# dashu.env (installation par l'assistant) : sans lui, une base restaurée
# sur une autre machine aurait ses jetons Google illisibles. Une seule copie,
# lisible par root seul.
if [ -f /var/lib/dashu/secret ]; then
  install -m 600 /var/lib/dashu/secret "$DIR/secret"
fi
find "$DIR" -name 'dashu-*.db' -mtime +14 -delete
find "$DIR" \( -name 'avant-maj-*.db' -o -name 'avant-restauration-*.db' \) -mtime +30 -delete
echo "$DEST"
# La première mise à jour qui l'apporte n'installe pas encore ce script
# (dashu-update installe la liste de sa propre version) : la copie du dépôt
# sert en attendant.
FILES_SCRIPT=/usr/local/sbin/dashu-backup-files
[ -x "$FILES_SCRIPT" ] || FILES_SCRIPT=/opt/dashu/src/deploy/lxc/dashu-backup-files
"$FILES_SCRIPT" "$STAMP"
