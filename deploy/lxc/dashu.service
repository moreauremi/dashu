[Unit]
Description=dashu (dashboard, notes, emploi du temps)
After=network-online.target
Wants=network-online.target

[Service]
User=dashu
Group=dashu
EnvironmentFile=/etc/dashu/dashu.env
WorkingDirectory=/var/lib/dashu
ExecStart=/usr/local/bin/dashu
Restart=on-failure
RestartSec=3
MemoryMax=256M
# Avant la limite dure, une limite douce : au-delà, le noyau récupère la
# mémoire de dashu (pages de fichiers comprises) et le ralentit, au lieu de
# le tuer en arrivant à MemoryMax.
MemoryHigh=192M

[Install]
WantedBy=multi-user.target
