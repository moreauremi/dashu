# Configuration de dashu. Copier ce fichier en `.env` et le remplir.
# Le fichier .env n'est jamais versionné : il contient des secrets.

# --- Obligatoire -------------------------------------------------------

# Clé de signature du cookie de session : 64 caractères minimum.
# À générer avec :  openssl rand -hex 32
SESSION_SECRET=

# Emails autorisés à se connecter, séparés par des virgules.
# Tout autre email est refusé, par identifiants comme par Google.
ALLOWED_EMAILS=toi@example.com

# URL publique du site, sans barre finale. En https, le cookie devient Secure.
BASE_URL=https://dashu.dev

# Emplacement de la base SQLite (créée au premier démarrage).
# En local :  sqlite://dashu.db      Dans Docker :  sqlite:///data/dashu.db
DATABASE_URL=sqlite:///data/dashu.db

# --- Connexion Google (facultatif) --------------------------------------
# Identifiants OAuth créés dans la Google Cloud Console (voir le README).
# Sans eux, seul le formulaire email + mot de passe est proposé.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Tunnel Cloudflare (lu par le conteneur cloudflared) ----------------
TUNNEL_TOKEN=

# --- Facultatif ---------------------------------------------------------
# Adresse d'écoute du serveur.
# BIND_ADDR=0.0.0.0:3000
# Logs en JSON (une ligne par événement) au lieu du format texte.
# LOG_FORMAT=json
# Niveau de log (par défaut : info).
# RUST_LOG=info
