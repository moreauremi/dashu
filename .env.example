# Configuration de dashu. Copier ce fichier en `.env` et le remplir.
# Le fichier .env n'est jamais versionné : il contient des secrets.

# --- Obligatoire -------------------------------------------------------

# Clé de signature du cookie de session : 64 caractères minimum.
# À générer avec :  openssl rand -hex 32
SESSION_SECRET=

# Emails autorisés à se connecter, séparés par des virgules.
# Tout autre email est refusé, par identifiants comme par Google.
ALLOWED_EMAILS=toi@example.com

# URL publique du site, sans barre finale. En https, le cookie devient Secure.
BASE_URL=https://dashu.dev

# Emplacement de la base SQLite (créée au premier démarrage).
# En local :  sqlite://dashu.db      Dans Docker :  sqlite:///data/dashu.db
# En production sans Docker (deploy/lxc) :  sqlite:///var/lib/dashu/dashu.db
DATABASE_URL=sqlite:///data/dashu.db

# --- Connexion Google (facultatif) --------------------------------------
# Identifiants OAuth créés dans la Google Cloud Console (voir le README).
# Sans eux, seul le formulaire email + mot de passe est proposé.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- API JSON (facultatif) ----------------------------------------------
# Active /api/v1 pour un programme (assistant…). Sans API_TOKEN, l'API répond 404.
# Jeton à générer avec :  openssl rand -hex 32
API_TOKEN=
# Compte au nom duquel agit l'API (doit figurer dans ALLOWED_EMAILS).
API_USER_EMAIL=

# --- Fichiers (facultatif) ----------------------------------------------
# Dossier où dashu range le contenu des fichiers envoyés. Sans lui, la page
# Fichiers l'indique et n'accepte aucun envoi.
# En local :  fichiers      En production (deploy/lxc) :  /srv/dashu/fichiers
FILES_DIR=
# Taille maximale d'un fichier, en Mo (par défaut : 2048).
# MAX_UPLOAD_MB=2048
# Dossier de travail partagé avec le service de conversion (`dashu worker`,
# qui lit la même variable). Sans lui, pas de bouton « Compresser ».
# En local :  travail      En production :  /srv/dashu/tmp
# WORK_DIR=

# --- Tunnel Cloudflare (lu par le conteneur cloudflared) ----------------
TUNNEL_TOKEN=

# --- Sauvegardes ---------------------------------------------------------
# Dossier de la machine hôte où scripts/backup.sh dépose les copies de la
# base (idéalement sur un second disque). Il doit appartenir à l'utilisateur
# 10001, celui du conteneur.
BACKUP_DIR=/mnt/backup/dashu

# --- Facultatif ---------------------------------------------------------
# Adresse d'écoute du serveur.
# BIND_ADDR=0.0.0.0:3000
# Logs en JSON (une ligne par événement) au lieu du format texte.
# LOG_FORMAT=json
# Niveau de log (par défaut : info).
# RUST_LOG=info
